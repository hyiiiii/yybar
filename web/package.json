{
  "name": "yybar-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply yybar --local",
    "db:migrate:remote": "wrangler d1 migrations apply yybar --remote",
    "deploy": "vite build && wrangler d1 migrations apply yybar --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
